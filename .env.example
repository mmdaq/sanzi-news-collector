# ============================================================
# 三资监管简报系统 - 环境变量配置
# ============================================================

# SMTP服务器（QQ邮箱: smtp.qq.com）
SMTP_SERVER=smtp.qq.com

# SMTP端口（SSL: 465）
SMTP_PORT=465

# 发送邮箱
SENDER_EMAIL=your_email@qq.com

# 邮箱授权码（不是登录密码！）
SENDER_PASSWORD=your_authorization_code

# 接收邮箱
RECEIVER_EMAIL=your_receiver@qq.com