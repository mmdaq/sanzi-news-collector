# ============================================================
# 三资监管简报系统 - 环境变量配置
# ============================================================

# SMTP服务器（QQ邮箱: smtp.qq.com）
SMTP_SERVER=smtp.qq.com

# SMTP端口（SSL: 465）
SMTP_PORT=465

# 发送邮箱
SENDER_EMAIL=your_email@qq.com

# 邮箱授权码（不是登录密码！）
SENDER_PASSWORD=your_authorization_code

# 接收邮箱（多个用英文逗号分隔）
RECEIVER_EMAIL=your_receiver@qq.com

# ============================================================
# 可选配置（以下均有默认值，按需修改）
# ============================================================

# 官方平台结果少于该值时启用搜索引擎备用方案（默认 2）
# MIN_OFFICIAL_RESULTS=2

# 是否启用搜索引擎备用方案（默认 true）
# SEARCH_ENABLED=true

# 自定义搜索关键词，多个用 | 分隔（默认内置 6 组）
# SEARCH_QUERIES=农村集体 "三资" 监管|村集体 资产 追回

# 时效窗口：当天没有时放宽到近几天（默认 7）
# DAYS_RANGE=7

# 没有新闻时是否仍发送"今日无相关新闻"简报（默认 true）
# SEND_EMPTY_EMAIL=true

# 简报最多条数（默认 30）
# MAX_BRIEF_ITEMS=30

# 调试：只生成简报不发送邮件（默认 false）
# DRY_RUN=true
